{
  "blockName": [
    {
      "mimeType": "video/*",
      "value": "Video"
    }
  ],
  "blockTemplate": [
    {
      "mimeType": "video/*",
      "value": "\u003Ctable border='1' style=\"width:100%\"\u003E\n  \u003Ctr\u003E\n        \u003Ctd style=\"background-color:#f5680a;color:#fff\"\u003E${blockName}\u003C/td\u003E\n      \u003C/tr\u003E\n      \u003Ctr\u003E\n        \u003Ctd\u003E\n        \u003Cimg src=\"${posterUrl}\" alt=\"${name}\"\u003E\n        \u003Cbr/\u003E\n        \u003Ca href=\"${videoUrl}\"\u003E${name}\u003C/a\u003E\n        \u003C/td\u003E\n      \u003C/tr\u003E   \u003C/table\u003E"
    }
  ],
